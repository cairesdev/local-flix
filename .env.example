# ====================================
# SUPERFLIX - Variaveis de Ambiente
# ====================================
# Copie este arquivo para .env.local e preencha os valores
# cp .env.example .env.local
#
# TODA a configuracao da aplicacao vem daqui - nada deve ficar
# hard-coded no codigo (veja src/lib/env.ts, que centraliza a leitura
# dessas variaveis).

# -------------------------------------
# TMDB API (OBRIGATORIO)
# -------------------------------------
# Crie uma conta em: https://www.themoviedb.org/signup
# Pegue sua chave em: https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_API_KEY="sua_chave_tmdb_aqui"

# Opcional - normalmente nao precisa alterar
# NEXT_PUBLIC_TMDB_BASE_URL="https://api.themoviedb.org/3"
# NEXT_PUBLIC_TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p"
# NEXT_PUBLIC_TMDB_LANGUAGE="pt-BR"

# -------------------------------------
# POSTGRESQL (OBRIGATORIO para producao)
# -------------------------------------
# String de conexao do PostgreSQL
# Formato: postgres://usuario:senha@host:porta/banco?sslmode=disable
# Sem essa variavel, o sistema roda em "modo offline" (dados em memoria,
# perdidos ao reiniciar) - util para testar localmente, nunca em producao.
POSTGRES_URL="postgres://usuario:senha@localhost:5432/superflix"

# -------------------------------------
# JWT / AUTENTICACAO (OBRIGATORIO em producao)
# -------------------------------------
# Chave secreta para assinar tokens JWT. Gere uma chave forte:
# openssl rand -base64 32
# Sem essa variavel em producao, um segredo aleatorio e gerado a cada
# reinicio do processo (todas as sessoes existentes sao invalidadas) -
# defina sempre um valor fixo em producao.
JWT_SECRET="seu_jwt_secret_aqui"

# Tempo de validade do token (formato aceito pela lib "jsonwebtoken", ex: "7d", "12h")
# JWT_EXPIRY="7d"

# Nome do cookie httpOnly usado para a sessao
# AUTH_COOKIE_NAME="auth_token"

# Duracao do cookie de sessao em segundos (padrao: 7 dias)
# AUTH_COOKIE_MAX_AGE="604800"

# -------------------------------------
# CONTROLE DE ACESSO (site fechado)
# -------------------------------------
# Se "true" (padrao), TODO o site exige login - inclusive o catalogo e a
# TV ao vivo. So ficam livres as paginas de login/registro e as paginas
# legais (termos, privacidade, DMCA). Defina "false" apenas em ambientes
# de demonstracao para permitir navegacao sem conta.
REQUIRE_LOGIN_FOR_ACCESS="true"

# Se o cadastro publico de novas contas esta disponivel. Tambem pode ser
# ligado/desligado em tempo real pelo painel administrativo
# (Configuracoes > "Permitir novos cadastros"), que tem prioridade sobre
# este valor depois da primeira inicializacao do banco.
ALLOW_REGISTRATION="false"

# -------------------------------------
# BOOTSTRAP DO ADMINISTRADOR (recomendado na primeira instalacao)
# -------------------------------------
# Usado por "npm run db:setup" (database/setup.js) e pelo modo offline
# para criar a primeira conta de administrador. Sem essas variaveis,
# nenhuma conta admin e criada automaticamente - crie manualmente pelo
# banco de dados ou por um usuario ja promovido a admin.
# NUNCA deixe credenciais reais commitadas no repositorio.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_BOOTSTRAP_NAME="Administrador"

# -------------------------------------
# ENDPOINT DE SETUP REMOTO (/api/setup) - opcional, avancado
# -------------------------------------
# Desativado por padrao (endpoint responde 404 sem esta variavel). Permite
# rodar o bootstrap do admin remotamente via POST + header
# "x-setup-secret". Defina um valor aleatorio SOMENTE quando for usar e
# remova/rotacione a variavel depois.
# SETUP_SECRET=""

# -------------------------------------
# SITE / MARCA
# -------------------------------------
# NEXT_PUBLIC_SITE_NAME="Superflix"
# NEXT_PUBLIC_SITE_DESCRIPTION="Plataforma de streaming com foco em TV ao vivo."
# URL base publica da aplicacao (usada em sitemap, metadados, callbacks)
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# -------------------------------------
# PROXY / BYPASS DE BLOQUEIOS (players de terceiros)
# -------------------------------------
# Os players de filmes/series/TV ao vivo sao de sites de terceiros que
# mudam de dominio com frequencia por causa de bloqueios de rede/DNS. O
# proxy resolve os dominios via DNS-over-HTTPS (Cloudflare por padrao) e
# reescreve as URLs para contornar bloqueios locais.
# NEXT_PUBLIC_USE_PROXY="true"
# DOH_RESOLVER_URL="https://1.1.1.1/dns-query"
# PROXY_TIMEOUT_MS="15000"

# Dominios extras (alem dos provedores cadastrados no admin) que tambem
# devem ser roteados pelo proxy, separados por virgula
# EXTRA_PROXY_DOMAINS=""

# -------------------------------------
# PROVEDORES DE CONTEUDO (fallback automatico)
# -------------------------------------
# Em producao com banco de dados configurado, os provedores de filmes/
# series e de TV ao vivo sao gerenciados pelo painel admin (aba
# "Provedores") - cadastre quantos espelhos quiser, com prioridade e
# health-check automatico. As variaveis abaixo servem apenas como carga
# inicial/fallback quando o banco nao esta configurado (modo offline).
# DEFAULT_VOD_PROVIDERS_JSON=""
# DEFAULT_TV_PROVIDERS_JSON=""

# Cache dos dados de provedores/canais em memoria (ms)
# PROVIDERS_CACHE_TTL_MS="600000"
# Falhas seguidas ate marcar um provedor como indisponivel e pular para o proximo
# PROVIDER_MAX_FAILURES="3"
